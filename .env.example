# Copy to `.env` next to this file and adjust; docker compose reads it
# automatically. Every variable the relay, the control plane and the two services
# it mounts validate appears here, and `compose.yaml` passes all of them through.
# An empty or commented value means "use the built-in default"; a malformed value
# stops the process at boot with a message naming the variable. Never commit
# `.env` -- it holds root credentials.

# ---------------------------------------------------------------- entry point
# Public hostname Caddy serves and requests a certificate for. Required for a
# real deployment. `localhost` uses Caddy's internal CA (browsers warn).
#
# Testing the whole product on this machine: set SUITE_DOMAIN=localhost, then
# https://app.localhost/admin.html is the operator panel and
# `docs/how-to/try-the-paid-flow.md` walks the rest. Leaving the placeholder here
# makes Caddy ask Let's Encrypt for a domain this machine does not own, which fails
# slowly and leaves every host answering nothing.
SUITE_DOMAIN=canvas.example.com

# ACME account email. Caddy's global `email` option reads it, and ZeroSSL needs it to
# mint account credentials.
SUITE_ACME_EMAIL=ops@example.com

# Certificate authority for ACME. Unset means Let's Encrypt. Set it to
# https://acme.zerossl.com/v2/DV90 to issue from ZeroSSL, which is what a deployment
# does after Let's Encrypt's five-duplicate-certificates-per-week limit is spent: the
# window is per hostname set and cannot be shortened by asking sooner.
# SUITE_ACME_CA=https://acme.zerossl.com/v2/DV90

# A second compose file, when the host runs one: `docker compose` and
# `deploy/deploy.sh` both read this, so an overlay for CloudWatch logs is named
# once instead of on every command.
# COMPOSE_FILE=compose.yaml:deploy/compose.aws.yaml

# The three production hosts and the static roots behind them. deploy/Caddyfile
# defaults to these names; a local stack should leave them at `*.localhost`
# (compose.yaml already does) so Caddy never asks Let's Encrypt for a domain it
# does not own.
# SUITE_APP_HOST=app.suite.run
# SUITE_DOCS_HOST=docs.suite.run
# SUITE_MARKETING_HOST=suite.run
# Where the docs and marketing sites are served from. Neither directory exists
# yet; a missing root answers 404, it does not stop Caddy.
# SUITE_DOCS_ROOT=/srv/docs
# SUITE_MARKETING_ROOT=/srv/marketing
# Where Caddy proxies `/api/auth/*`, `/api/billing/*` and `/stripe/*`.
# SUITE_CONTROL_PLANE_UPSTREAM=control-plane:1236

# Image reference compose runs. Nothing is pulled from a registry: the name here
# is a tag on an image built on this host. `deploy/deploy.sh` writes
# `suite:v<version>` into this line after each build, so keep it at a tag rather
# than a moving name. Unset means `suite:local`, which `docker compose build`
# produces from the checkout. A rollback points it at a `suite:rollback-<version>`
# tag taken before the upgrade; `deploy/deploy.sh --rollback` does that edit.
# SUITE_IMAGE=suite:v1.1.0

# Base URL used for links created by POST /api/admin/fixtures. Behind a proxy,
# set it so fixture links work outside the host.
# SUITE_PUBLIC_URL=https://canvas.example.com

# ------------------------------------------------------------------ credentials
# The operator surface has no secret of its own. `/api/admin/*`, the /admin panel
# and /metrics answer a signed-in *account* whose address is on this list, so
# revoking an operator is a restart rather than a rotation and the audit line names
# a person. Comma-separated, matched case-insensitively. Unset means nobody.
# SUITE_ADMIN_EMAILS=you@example.com
# 1 lets a scrape from this machine read /metrics with no credential, which is what
# a cron timer on the box needs: it has no browser and cannot hold a session. It
# opens nothing else, and a request through the proxy is never a loopback request.
#
# A deployment that runs `deploy/cloudwatch/probe.sh` needs this set to 1. Without it
# the probe gets a 401, publishes Health=0, and the two health alarms go red while the
# site is perfectly fine: measure it, do not assume it.
SUITE_METRICS_LOCAL=1

# Worker tokens. Generate each with `openssl rand -base64 32`; when unset the
# server generates one per start, which only matters if a worker reconnects.
SUITE_PROJECTION_TOKEN=
SUITE_SOURCE_TOKEN=
# Legacy alias for SUITE_PROJECTION_TOKEN, still accepted; leave unset.
# SUITE_INTERNAL_TOKEN=

# ------------------------------------------------------------------------- mode
# 1 = hosted relay: licences are enforced and the hosted quota defaults apply.
# 0 = self-host: no licence, unlimited quotas unless you set them below.
SUITE_HOSTED=0

# The self-host licence: one signed token, the line `licence sign` prints.
# The relay verifies it at boot against SUITE_LICENCE_PUBLIC_KEY, applies its
# workspaces / documentBytes / attachmentBytes caps, and refuses to start when it
# does not verify. Empty means an unlicensed instance. Setting it beside
# SUITE_HOSTED=1 stops the process: a hosted relay reads capacity from the
# organization's subscription instead.
SUITE_LICENCE=

# Ed25519 public key that verifies licences; required when SUITE_HOSTED=1 or
# SUITE_LICENCE is set.
# Generate the pair offline with:
#   pnpm --filter @suite/collab-server licence generate-keypair --out ./licence-private.pem
# Paste the printed public key here and keep the private key out of the repo.
SUITE_LICENCE_PUBLIC_KEY=

# Encrypts the secrets the operator panel stores: the Stripe keys, the Resend API
# key, the Turnstile secret, one mode's set at a time. 32 bytes, base64 or
# base64url, and the same value on every host that shares the database, because a
# row written under one key cannot be read under another. Without it a save in
# `/admin/settings` answers 503 `settings-key-missing` and the panel cannot hold a
# secret at all, which is the one deployment mistake this file cannot warn about
# by itself.
#   openssl rand -base64 32
SUITE_SETTINGS_KEY=

# Extra browser origins allowed to call the HTTP API (comma separated). Leave
# empty for a same-origin deployment: Caddy proxies `/api` and `/ws`, so the
# browser never makes a cross-origin request.
SUITE_ALLOWED_ORIGINS=

# Account deletion purges the relay's documents, shares and attachments through
# the relay's own delete route. Without this pair the erase still removes the
# account and reports those three stores as not-configured with a follow-up
# command, which is what a self-host wants. A dedicated token, not the admin
# token: the control plane is the internet-facing process, and a fault there
# must not reach every workspace's limits and rooms.
SUITE_RELAY_URL=
SUITE_RELAY_PURGE_TOKEN=

# 1 uses the first X-Forwarded-For hop as the client address for rate limits.
# Read the caveat in docs/deploy-aws.md before enabling it behind Cloudflare:
# Caddy then sees Cloudflare's edge, not the visitor, unless it trusts them.
SUITE_TRUST_PROXY=0

# info (default), debug, warn or error. debug logs every request detail.
SUITE_LOG_LEVEL=info

# ------------------------------------------------------------------------- ports
# Fixed by compose.yaml (1234 sync, 1235 HTTP/health). Only override together
# with the matching `expose`/proxy configuration.
# PORT=1234
# HEALTH_PORT=1235

# Version stamp reported by /metrics, /api/admin/status and the startup line.
# The image sets it from the release tag; empty is rejected, so leave it unset
# unless you build locally and want a different stamp.
# SUITE_VERSION=0.0.0

# ---------------------------------------------------------------------- storage
# Six stores exist in code (`documents`, `shares`, `workspaces`, `settings`,
# `licences`, `attachments`) and `compose.yaml` configures all six on the
# `suite-data` volume. Attachments used to default to the process working
# directory, and settings and licences to `:memory:`; all three were lost when
# the container was recreated. Every store below therefore defaults to a file
# under `/data`, and a restore replaces all six together.
#
# Only override for a custom layout, and give each store its own file (or
# `:memory:`, which makes that store disposable). Paths outside `/data` are not
# in the volume, so they are not backed up and not restored.
# SUITE_DB=/data/documents.sqlite
# SUITE_SHARES_DB=/data/shares.sqlite
# SUITE_WORKSPACES_DB=/data/workspaces.sqlite
# SUITE_SETTINGS_DB=/data/settings.sqlite
# SUITE_LICENCE_DB=/data/licences.sqlite
# SUITE_ATTACHMENTS_DB=/data/attachments.sqlite
#
# A composed deployment refuses to start on a disposable store layout.
# `compose.yaml` sets this to 1; set it yourself on a host that runs the server
# without compose. Every one of the six paths above must then be absolute, must
# not be `:memory:`, and must sit in one directory (the volume root). Leave it
# unset for a local run or the tests, where `:memory:` and CWD paths are fine.
# SUITE_REQUIRE_DURABLE_STORES=1

# ------------------------------------------------------- control plane database
# The second process (`apps/control-plane`) owns Postgres: accounts,
# organizations, subscriptions and licence records share one database, and no
# document bytes ever go there. These three settings create it; the URL below is
# what both services connect with.
POSTGRES_USER=suite
POSTGRES_PASSWORD=suite
POSTGRES_DB=suite
# Connection string for the control plane. Required as soon as the auth or
# billing module is mounted: without it the process refuses to boot by name.
# A managed database has no `postgres` hostname on the network, so point this at
# the server itself and turn TLS on:
#   postgres://user:pass@db.example.internal:5432/suite?sslmode=require
# SUITE_CONTROL_PLANE_DATABASE_URL=postgres://suite:suite@postgres:5432/suite

# --------------------------------------------------------------------- accounts
# The account service is off by default. With it unset every auth route answers
# `auth-not-configured`, so nobody can sign in, sign up or join an organization.
SUITE_AUTH_ENABLED=0
# Session cookie signing secret, at least 32 characters. Without it no session
# can be sealed or verified and sign-in cannot complete.
# SUITE_AUTH_SECRET=
# Public origin the control plane signs sessions for (https://app.suite.run).
# Without it the control plane refuses to boot, because it cannot build a
# redirect or a link. The relay reads the same value: it verifies a session JWT
# against the key set published at <origin>/api/auth/jwks and compares the
# token's issuer and audience to it, so an unset value means no account can sync.
# SUITE_AUTH_URL=
# Where the relay fetches the key set, when that is not the public origin. A compose
# deployment reaches the control plane as `control-plane:1236`, and asking it to
# resolve its own public hostname through the proxy is a hairpin that fails behind
# `*.localhost` and on hosts that cannot resolve their own address. Unset means the
# public origin answers for both.
# SUITE_AUTH_JWKS_URL=http://control-plane:1236/api/auth/jwks
# Postgres for accounts and organizations. Unset means no accounts at all: the
# auth module cannot open a pool.
# SUITE_AUTH_DATABASE_URL=
# Google sign-in, both or neither: one half is refused at boot. With neither the
# "Continue with Google" button never appears.
# SUITE_GOOGLE_CLIENT_ID=
# SUITE_GOOGLE_CLIENT_SECRET=
# WebAuthn relying-party id; the registrable domain (suite.run, not
# app.suite.run). Unset means "localhost", so passkeys fail on a real domain.
# SUITE_AUTH_RP_ID=
# Name shown in passkey prompts and authenticator apps. Unset falls back to
# "Suite", which is wrong for a white-label deployment.
# SUITE_AUTH_RP_NAME=
# Organizations one account may own. Unset is 1, so a second organization
# cannot be created and the account is stuck in its first tenant.
# SUITE_AUTH_MAX_ORGS_PER_USER=1
# Cloudflare Turnstile secret. Unset leaves sign-up with no captcha in front of
# it, which is the self-host default and an open door on a public host.
# SUITE_TURNSTILE_SECRET=
# The same widget's site key. It is public by design, but it has to be a *build*
# argument: the canvas is compiled inside the image, so a value only in the
# environment never reaches the browser and the widget never renders. A deploy
# with the secret set and this empty is a sign-up form that cannot pass the
# challenge, which is why compose passes both.
# SUITE_TURNSTILE_SITE_KEY=
# 1 holds every new account until an operator admits it; unset admits at once.
# Holding without an operator in SUITE_ADMIN_EMAILS above is refused at startup:
# the queue would have no door. Admit someone from the operator panel, signed
# in as one of those addresses.
# SUITE_ADMISSION_REQUIRED=0
# Where an admitted person is told to go. Only used by the admission notice; unset
# admits without sending one.
# SUITE_APP_URL=https://app.example.com
# Require a confirmed address before a session is issued. Unset means required,
# which is right for any deployment. A local run sets it to 0 because there is no
# mailbox to click, and the console transport redacts the token it prints.
# SUITE_AUTH_REQUIRE_VERIFICATION=0

# ------------------------------------------------------------------------- mail
# How sign-up mail leaves the process: console (default, prints the link and
# redacts the token), resend, or smtp. Anything else refuses to boot, because a
# typo here is every verification email going nowhere.
# SUITE_MAIL_TRANSPORT=console
# The sending address, e.g. `Suite <hello@example.com>`. Required by resend and
# smtp; the console transport does not read it.
# SUITE_MAIL_FROM=
# Resend API key (re_…). Required by SUITE_MAIL_TRANSPORT=resend.
# RESEND_API_KEY=
# Submission URL for SUITE_MAIL_TRANSPORT=smtp: `smtp://user:pass@host:587` or
# `smtps://host:465`. StartTLS is used when the server offers it.
# SUITE_SMTP_URL=
# 1 (the default) refuses a relay with no StartTLS. Set 0 for a relay on a
# loopback or a private network that has none.
# SUITE_SMTP_REQUIRE_TLS=1
# Where the in-app feedback bubble sends. Unset turns the bubble off: the client
# hides it rather than offering a form nothing will send. The endpoint is public
# and anonymous by design, so it carries its own per-address limit and body cap,
# and a Turnstile challenge whenever SUITE_TURNSTILE_SECRET is set.
# SUITE_FEEDBACK_TO=you@example.com

# Who may reach the operator surface: Caddy serves /admin*, /metrics and
# /api/admin* only to these networks. A deployed host keeps the Tailscale
# tailnet (100.64.0.0/10); a local stack adds the Docker bridge, which is what
# compose defaults to.
# SUITE_OPERATOR_ALLOW=100.64.0.0/10 127.0.0.1/32 ::1/128

# ---------------------------------------------------------------------- billing
# Billing is closed by default: checkout, the portal and the webhook all answer
# 503, so nothing can be sold.
SUITE_BILLING_ENABLED=0
# Stripe secret key (sk_test_… locally). Without it checkout and the portal
# cannot create a session. `pnpm stripe` prints the one it found.
# STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…). Print it with `pnpm stripe --listen`. Without
# it every delivery fails verification with 400, so no payment is recorded.
# STRIPE_WEBHOOK_SECRET=
# Price id to tier table, as JSON. `pnpm stripe` creates the prices from
# `deploy/stripe/fixtures.json` and prints this line ready to paste. Without it a
# paid price maps to no tier and a checkout cannot be priced.
#
# Keep the single quotes. The value is JSON, and anything that *sources* this file
# (a deploy script, a shell) strips the inner double quotes without them, which
# leaves a value the parser rejects at request time: the process boots, `/health`
# says ok, and the first `/api/billing/plans` answers 500 invalid-config.
#   STRIPE_PRICE_TIERS='{"price_123":{"tier":"personal","seats":1,"workspaces":3,"documentBytes":268435456,"attachmentBytes":1073741824}}'
# STRIPE_PRICE_TIERS=

# ----------------------------------------------------------------------- quotas
# Bytes, counts, or "unlimited". Leaving them unset is the safe choice: a
# self-host is unlimited (except the 100 links / 200 cards caps below), and
# SUITE_HOSTED=1 installs a 32 MiB projection budget plus 4 GiB / 5 GiB disk
# watermarks. Setting "unlimited" here would override those guardrails.
# SUITE_MAX_WORKSPACES=unlimited
# SUITE_DOCUMENT_BYTES_PER_WORKSPACE=unlimited
# SUITE_PROJECTION_BYTES_PER_WORKSPACE=unlimited
# SUITE_ATTACHMENT_BYTES_PER_WORKSPACE=unlimited
SUITE_MAX_SHARES_PER_WORKSPACE=100
SUITE_MAX_SELECTION_CARDS=200
# SUITE_DISK_SOFT_BYTES=unlimited
# SUITE_DISK_HARD_BYTES=unlimited

# ------------------------------------------------------------- rate limits/min
# Server-side limiters, per client address. Empty keeps the default shown.
# SUITE_CLAIM_RATE_LIMIT=600
# SUITE_ROTATE_RATE_LIMIT=10
# SUITE_SHARE_RESOLVE_RATE_LIMIT=300
# SUITE_SHARE_CREATE_RATE_LIMIT=30
# SUITE_PUBLISH_RATE_LIMIT=20
# SUITE_ADMIN_RATE_LIMIT=300

# ------------------------------------------------------------ build-time only
# Baked into the canvas bundle by `pnpm build`; leave empty for the same-origin
# defaults (`/api` and `ws(s)://<host>/ws`).
# VITE_COLLAB_HTTP_URL=
# VITE_COLLAB_URL=
# Base URL of the account service. Unset means the canvas calls `/api/auth` on
# its own origin; set it only when accounts live on a different host, or the
# sign-in UI has no endpoint to call.
# VITE_SUITE_AUTH_URL=
