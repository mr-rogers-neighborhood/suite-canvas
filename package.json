{
  "name": "suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "check": "biome check . && turbo run typecheck && vitest run --changed && pnpm docs:symbols && pnpm shape",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:stories": "pnpm --filter @suite/canvas test:stories",
    "coverage": "vitest run --coverage",
    "coverage:graph": "vitest run --coverage --project=graph --coverage.include='packages/graph/src/**'",
    "test:watch": "vitest",
    "mutation": "stryker run stryker.graph.config.mjs",
    "mutation:server": "stryker run stryker.server.config.mjs",
    "mutation:quick": "stryker run stryker.quick.config.mjs",
    "bench": "vitest bench --config vitest.bench.config.ts --reporter=verbose",
    "e2e": "pnpm --filter @suite/e2e e2e",
    "e2e:full": "pnpm --filter @suite/e2e e2e:full",
    "e2e:canvas": "pnpm --filter @suite/e2e e2e:canvas",
    "e2e:collab": "pnpm --filter @suite/e2e e2e:collab",
    "e2e:views": "pnpm --filter @suite/e2e e2e:views",
    "e2e:doctor": "pnpm --filter @suite/e2e e2e:doctor",
    "e2e:stop": "pnpm --filter @suite/e2e e2e:stop",
    "e2e:logs": "pnpm --filter @suite/e2e e2e:logs",
    "e2e:ui": "pnpm --filter @suite/e2e e2e:ui",
    "e2e:ui:stop": "pnpm --filter @suite/e2e e2e:ui:stop",
    "e2e:headed": "pnpm --filter @suite/e2e e2e:headed",
    "e2e:trace": "pnpm --filter @suite/e2e e2e:trace",
    "e2e:smoke": "pnpm --filter @suite/e2e e2e:smoke",
    "e2e:changed": "pnpm --filter @suite/e2e e2e:changed",
    "storybook": "pnpm --filter @suite/canvas storybook",
    "build-storybook": "pnpm --filter @suite/canvas build-storybook",
    "verify": "node scripts/scratchpad.mjs --quiet && pnpm lint && pnpm typecheck && pnpm test && pnpm turbo run test --filter=@suite/billing && pnpm test:stories && pnpm build && pnpm docs:check && pnpm docs:symbols && pnpm shape",
    "db:verify": "node scripts/db-verify.mjs",
    "stripe": "bash deploy/stripe/setup.sh",
    "docs:check": "node scripts/docs-check.mjs && node scripts/generate-doc-indexes.mjs --check && node scripts/generate-limits.mjs --check",
    "docs:symbols": "node scripts/check-docs-symbols.mjs",
    "shape": "node scripts/check-shape.mjs",
    "docs:site": "pnpm --filter @suite/docs dev",
    "docs:site:build": "pnpm --filter @suite/docs build",
    "docs:site:start": "pnpm --filter @suite/docs start",
    "site:dev": "pnpm --filter @suite/site dev",
    "site:build": "pnpm --filter @suite/site build",
    "site:start": "pnpm --filter @suite/site start",
    "limits:check": "node scripts/generate-limits.mjs --check",
    "knip": "knip",
    "clean": "rm -rf apps/*/dist apps/*/storybook-static packages/*/dist .turbo apps/*/.turbo packages/*/.turbo",
    "prepare": "husky",
    "scratchpad": "node scripts/scratchpad.mjs",
    "docs:index": "node scripts/generate-doc-indexes.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}": "biome check --write"
  }
}
