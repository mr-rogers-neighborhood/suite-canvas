# The reverse proxy and static host for every origin this project serves.
#
# Four sites, and only one of them is required:
#
# 1. `{$SUITE_DOMAIN:localhost}` — the single-host site. Self-hosting with one
#    domain, and local development: `localhost` uses Caddy's internal CA, so
#    `docker compose up` needs no DNS record and no certificate authority.
# 2. `{$SUITE_APP_HOST:app.suite.run}` — the hosted app: the canvas from /srv,
#    the relay's API and socket, and the control plane's accounts and billing.
# 3. `{$SUITE_DOCS_HOST:docs.suite.run}` — the documentation site, a static
#    root that is empty today; a missing root answers 404 instead of stopping
#    Caddy, so this block can ship before the site does.
# 4. `{$SUITE_MARKETING_HOST:suite.run}` — the marketing site, same shape.
#
# Every host, root and upstream is an environment variable with a default, so a
# deployment changes hostnames without editing this file. A local stack that
# does not own the production domains should point 2-4 at `*.localhost`
# (`compose.yaml` does) — Caddy keeps serving the sites it can, and only logs
# the certificate failures for the ones it cannot.
#
# One host, one instance, one `app` replica: rooms, presence and rate limits
# live in that process and the documents are local files. See
# docs/how-to/deploy.md.
{
	# Uncomment to register the ACME account with an email from the environment.
	# email {$SUITE_ACME_EMAIL}
	servers {
		protocols h1 h2
	}
}

# One definition of the headers every site sends. A site adds its own
# Content-Security-Policy, because `connect-src` names the origin whose
# WebSocket the page may open and that origin differs per site.
#
# Every CSP below allows `img-src ... https:` because an image can be a link the
# document carries instead of bytes the relay stores. The viewer's browser then
# fetches a third party's image, with `referrerpolicy="no-referrer"` on every
# such node; that relaxation is the cost of link images.
(suite_security_headers) {
	header {
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# Where a blocked resource reports. Both names are needed: `report-to` is the
# modern Reporting API and reads the group below, `report-uri` is what every
# other browser still sends. The endpoint is the relay's, so only the two sites
# that proxy `/api/*` to it import this; a docs host has no API to report to and
# sending it there would only teach the browser that reporting is broken.
#
# The policy stays *enforcing*. Nothing here sets `Content-Security-Policy-
# Report-Only`: a report-only policy protects nobody, and a site that switched to
# it without saying so would look safe and be open.
(suite_csp_reporting) {
	header Report-To "{\"group\":\"suite-csp\",\"max_age\":10886400,\"endpoints\":[{\"url\":\"https://{http.request.host}/api/report/csp\"}]}"
	header Reporting-Endpoints "suite-csp=\"https://{http.request.host}/api/report/csp\""
}

# Caching for the canvas, in one place. Vite content-hashes the bundles under
# /assets/*, so those never change and may be cached for a year. Everything
# else is JSON on /api/*, a token-gated scrape, a WebSocket upgrade, one of the
# two HTML entry points, or the SPA fallback -- all of it must be revalidated,
# so a deploy or a revoked link is visible on the next request.
(suite_caching) {
	@hashed path /assets/*
	@uncached not path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header @uncached Cache-Control "no-store"
}

# Local development and single-host self-hosting: `SUITE_DOMAIN` or `localhost`.
{$SUITE_DOMAIN:localhost} {
	encode zstd gzip
	import suite_security_headers
	import suite_csp_reporting
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' wss://{$SUITE_DOMAIN:localhost}; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'; report-uri /api/report/csp; report-to suite-csp"
	import suite_caching

	# Loro sync. No special directive is needed: reverse_proxy forwards the
	# Upgrade/Connection handshake and switches to a raw tunnel on 101 by
	# default. Keep the route free of buffering handlers, and do not run two
	# `app` containers behind it.
	handle /ws* {
		reverse_proxy app:1234
	}

	# The HTTP API (shares, workspaces, CSP reports) and the health probe share
	# port 1235.
	handle /api/* {
		reverse_proxy app:1235
	}

	handle /health {
		reverse_proxy app:1235
	}

	# Prometheus scrape. The endpoint is token-gated by the server itself: 404
	# when SUITE_ADMIN_TOKEN is unset, 401 without the bearer token, 429 above
	# the admin rate limit. It is proxied for a scraper but never published or
	# listed anywhere -- an external monitor should call /health instead.
	handle /metrics {
		reverse_proxy app:1235
	}

	# Hashed bundles. A missing file is a 404, not the SPA fallback: serving
	# index.html under a .js URL with a one-year immutable header is a mistake
	# that cannot be corrected remotely.
	handle /assets/* {
		root * /srv
		file_server
	}

	# Operator panel: its own Vite entry point, never linked from the app.
	# Not being linked is obscurity, not access control -- the token behind it
	# can read every workspace and delete any of them. Uncomment the two lines
	# to restrict the panel to an allowlist of office/VPN addresses; the first
	# one names every source that is *not* allowed:
	#   @admin_denied not remote_ip 203.0.113.4/32 10.0.0.0/8
	#   respond @admin_denied "Not found" 403
	handle /admin* {
		rewrite * /admin.html
		root * /srv
		file_server
	}

	# Static app with the SPA fallback: every unknown path is a client route.
	# Directory listings stay off (`browse`), so /srv is never indexable.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# The hosted app: the same surface as above, plus the control plane. Accounts
# (`/api/auth/*`), billing (`/api/billing/*`) and the Stripe webhook
# (`/stripe/*`) are answered by the second process, which owns Postgres; every
# other path stays on the relay. The specific matchers are declared first and
# are also the longer paths, so either ordering rule Caddy applies picks them.
{$SUITE_APP_HOST:app.suite.run} {
	encode zstd gzip
	import suite_security_headers
	import suite_csp_reporting
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' wss://{$SUITE_APP_HOST:app.suite.run}; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'; report-uri /api/report/csp; report-to suite-csp"
	import suite_caching

	handle /api/auth/* {
		reverse_proxy {$SUITE_CONTROL_PLANE_UPSTREAM:control-plane:1236}
	}

	handle /api/billing/* {
		reverse_proxy {$SUITE_CONTROL_PLANE_UPSTREAM:control-plane:1236}
	}

	# The account surface: the workspace list the launcher reads, export, erase,
	# claiming a workspace, redeeming an invitation, and the members of one.
	# These are the control plane's, and the relay answers none of them.
	handle /api/account/* {
		reverse_proxy {$SUITE_CONTROL_PLANE_UPSTREAM:control-plane:1236}
	}

	handle /api/invites/* {
		reverse_proxy {$SUITE_CONTROL_PLANE_UPSTREAM:control-plane:1236}
	}

	handle /api/workspaces/claim {
		reverse_proxy {$SUITE_CONTROL_PLANE_UPSTREAM:control-plane:1236}
	}

	@members path_regexp members ^/api/workspaces/[^/]+/members$
	handle @members {
		reverse_proxy {$SUITE_CONTROL_PLANE_UPSTREAM:control-plane:1236}
	}

	# The operator admission queue. Declared before the `/admin` panel rewrite
	# below, which would otherwise serve it an HTML page. It answers only to a
	# bearer token, and 503 when `SUITE_ADMIN_TOKEN` is unset.
	handle /admin/admissions {
		reverse_proxy {$SUITE_CONTROL_PLANE_UPSTREAM:control-plane:1236}
	}

	# Stripe posts here. The signature is verified by the service, not here.
	handle /stripe/* {
		reverse_proxy {$SUITE_CONTROL_PLANE_UPSTREAM:control-plane:1236}
	}

	handle /ws* {
		reverse_proxy app:1234
	}

	handle /api/* {
		reverse_proxy app:1235
	}

	handle /health {
		reverse_proxy app:1235
	}

	handle /metrics {
		reverse_proxy app:1235
	}

	handle /assets/* {
		root * /srv
		file_server
	}

	handle /admin* {
		rewrite * /admin.html
		root * /srv
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# The documentation site. `SUITE_DOCS_ROOT` names a directory that does not
# exist yet; a request for anything under a missing root is a 404, not a Caddy
# startup failure, which is what lets this route ship before the site does.
#
# Two relaxations the other hosts do not need. Starlight emits inline
# `<script type="module">` for the theme toggle, the sidebar and the search
# index, so `script-src` needs `'unsafe-inline'`; there is no user content on
# this origin, which is what makes that acceptable here and nowhere else.
# `connect-src` stays `'self'` because Pagefind fetches its index from this
# origin, so the docs host may not call the API.
{$SUITE_DOCS_HOST:docs.suite.run} {
	encode zstd gzip
	import suite_security_headers
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'"

	handle {
		root * {$SUITE_DOCS_ROOT:/srv/docs}
		file_server
	}
}

# The marketing site, with the same missing-root behaviour and no API of its own.
{$SUITE_MARKETING_HOST:suite.run} {
	encode zstd gzip
	import suite_security_headers
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'"

	handle {
		root * {$SUITE_MARKETING_ROOT:/srv/marketing}
		file_server
	}
}
