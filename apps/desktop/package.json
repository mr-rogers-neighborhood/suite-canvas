{
  "name": "@suite/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Canvas desktop shell: main process owns the file, the lock, the backups and recovery; the preload publishes one allowlisted bridge; the renderer is the existing canvas build.",
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/stage.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@suite/files": "git+https://github.com/mr-rogers-neighborhood/suite-start.git#v0.1.0&path:/packages/files",
    "@suite/graph": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.2",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
