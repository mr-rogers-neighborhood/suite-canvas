{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // A dropped promise is a dropped error: nothing awaits the rejection, so
      // a failed write or a stuck request leaves no trace. Zero hits today,
      // which makes this free insurance against the next forgotten `await`.
      "nursery": {
        "noFloatingPromises": "error"
      },
      // Shape rules that share one spelling of an idea. Both are already
      // satisfied repo-wide, so they cost nothing today and stop the next
      // `let`-that-is-never-reassigned or `cond ? true : false` from landing.
      //
      // `style/noNestedTernary` stays off on purpose. The rule exists in 2.5.15
      // (promoted out of `nursery`, so `nursery/noNestedTernary` is an unknown
      // key), but it finds 20 ternaries across 14 existing files — a rewrite
      // dressed as a config change. Turn it on when those call sites are
      // touched for their own reasons.
      "style": {
        // A `let` that is never reassigned reads as mutable state; `const` says
        // what the binding is.
        "useConst": "error"
      },
      "complexity": {
        // A ratchet, not a target. The two functions above the limit are being
        // split; lower this as they come down. A rule that fails on day one
        // gets switched off, so it starts where the tree already passes.
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 120 }
        },
        // `a ? true : false` is `Boolean(a)`; the ternary only adds a branch to
        // read past.
        "noUselessTernary": "error"
      },
      // The security group: DOM sinks that execute strings, and the credential
      // check. `noSecrets` is `error` so a key in the tree fails `pnpm lint`;
      // gitleaks in the pre-commit hook covers history, which a lint of the
      // working tree cannot see.
      "security": {
        "noBlankTarget": "error",
        "noDangerouslySetInnerHtml": "error",
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "noGlobalEval": "error",
        "noScriptUrl": "error",
        // Biome's default entropy threshold is 41 (4.1 bits per character),
        // which flags 111 camelCase identifiers in this tree
        // (`MigrationChecksumError`, `getCheckoutSessionParams`, …) and none of
        // them is a credential. At 50 the entropy pass reports nothing, while
        // the rule's fixed patterns — JWTs, AWS keys, private-key blocks,
        // provider tokens — still match regardless of the threshold.
        "noSecrets": {
          "level": "error",
          "options": { "entropyThreshold": 50 }
        }
      }
    }
  },
  "overrides": [
    {
      // Test fixtures hold credentials on purpose: a crash-report scrubber needs
      // a JWT to remove, a diagnostics test needs a share token to redact, a
      // config test needs a database URL with a password in it. Biome reads
      // those as leaks (ten sites today, all fake), and an inline disable on
      // each would be a longer allowlist than `.gitleaks.toml` already keeps.
      // gitleaks still scans these files with the same value-level allowlist, so
      // a real key in a test fails the pre-commit hook and `pnpm security:secrets`.
      "includes": ["**/*.{test,spec}.{ts,tsx}", "scripts/dev-env.mjs"],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": "off"
          }
        }
      }
    },
    {
      // Biome has no Astro template parser: it reads an `.astro` frontmatter
      // block as a module of its own, so every name the template uses looks
      // unused and `lint:fix` would delete the imports. `astro check` covers
      // these files instead.
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      // A generated file is not a source file: `scripts/sync-handbook.mjs` writes it, and
      // `pnpm docs:check` fails when it is stale. Reformatting it here would make the two
      // disagree on every run.
      "includes": ["apps/canvas/src/handbook/articles.generated.ts"],
      "formatter": { "enabled": false },
      "assist": { "enabled": false },
      "linter": { "enabled": false }
    },
    {
      // One logging path: request handlers log through `logging.ts`, which
      // writes JSON lines with a request id and redacted capability paths.
      // Only the logger itself, and the licence CLI whose stdout/stderr *is*
      // its product, may write to the console.
      "includes": [
        "apps/collab-server/src/**",
        "!apps/collab-server/src/logging.ts",
        "!apps/collab-server/src/licenceCli.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
