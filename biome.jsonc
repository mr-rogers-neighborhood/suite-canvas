{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // A dropped promise is a dropped error: nothing awaits the rejection, so
      // a failed write or a stuck request leaves no trace. Zero hits today,
      // which makes this free insurance against the next forgotten `await`.
      "nursery": {
        "noFloatingPromises": "error"
      },
      // Shape rules that share one spelling of an idea. Both are already
      // satisfied repo-wide, so they cost nothing today and stop the next
      // `let`-that-is-never-reassigned or `cond ? true : false` from landing.
      //
      // `style/noNestedTernary` stays off on purpose. The rule exists in 2.5.15
      // (promoted out of `nursery`, so `nursery/noNestedTernary` is an unknown
      // key), but it finds 20 ternaries across 14 existing files — a rewrite
      // dressed as a config change. Turn it on when those call sites are
      // touched for their own reasons.
      "style": {
        // A `let` that is never reassigned reads as mutable state; `const` says
        // what the binding is.
        "useConst": "error"
      },
      "complexity": {
        // `a ? true : false` is `Boolean(a)`; the ternary only adds a branch to
        // read past.
        "noUselessTernary": "error"
      }
    }
  },
  "overrides": [
    {
      // One logging path: request handlers log through `logging.ts`, which
      // writes JSON lines with a request id and redacted capability paths.
      // Only the logger itself, and the licence CLI whose stdout/stderr *is*
      // its product, may write to the console.
      "includes": [
        "apps/collab-server/src/**",
        "!apps/collab-server/src/logging.ts",
        "!apps/collab-server/src/licenceCli.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
