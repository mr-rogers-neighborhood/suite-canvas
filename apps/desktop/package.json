{
  "name": "@suite/desktop",
  "desktopName": "suite-canvas.desktop",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "description": "The Canvas desktop shell: main process owns the file, the lock, the backups and recovery; the preload publishes one allowlisted bridge; the renderer is the existing canvas build.",
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "pnpm --filter @suite/canvas build:standalone && tsc -p tsconfig.build.json && node scripts/stage.mjs",
    "dev:shell": "node scripts/shell.mjs",
    "dev:shell:watch": "node scripts/watch.mjs",
    "package:dir": "pnpm build && electron-builder --dir",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@suite/contracts": "git+https://github.com/mr-rogers-neighborhood/suite-start.git#v0.7.0&path:/packages/contracts",
    "@suite/desktop": "git+https://github.com/mr-rogers-neighborhood/suite-start.git#v0.6.1&path:/packages/desktop",
    "@suite/files": "git+https://github.com/mr-rogers-neighborhood/suite-start.git#v0.6.1&path:/packages/files",
    "@suite/graph": "workspace:*",
    "electron-updater": "^6.6.2",
    "zod": "^4.6.7",
    "@suite/sync": "git+https://github.com/mr-rogers-neighborhood/suite-sync.git#v0.11.3&path:/packages/protocol"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.2.2",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "author": {
    "name": "Suite contributors",
    "email": "maintainers@suite.run"
  },
  "license": "MIT"
}
