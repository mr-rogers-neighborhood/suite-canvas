*storybook.log

# Stryker: HTML/JSON reports are build output; the incremental file is
# per-machine state (mutant ids and timings), so committing it would let a
# stale score masquerade as a fresh one.
reports/
.stryker-tmp/
stryker.log

# Measurement scratch: JSON dumps and one-off probes kept while a change is
# being verified. Never imported, never shipped, and never worth a lint error.
.scratch/

# Isolated checkouts for parallel workstreams.
.worktrees/

# Chrome profile the ICE launcher (`pnpm dev:ice`) owns.
.ice-chrome-profile/
