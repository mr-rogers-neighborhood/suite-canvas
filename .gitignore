node_modules/
dist/
coverage/
.turbo/
*.local
.env
.env.*
!.env.example
.vite/
storybook-static/
playwright-report/
test-results/
blob-report/
# Per-run e2e state: relay databases and captured server logs. Both are
# disposable, and a committed log is a stale clue.
e2e/.data/
e2e/.artifacts/
.DS_Store
*.tsbuildinfo
*.log
# Hocuspocus document store
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

*storybook.log

# Stryker: HTML/JSON reports are build output; the incremental file is
# per-machine state (mutant ids and timings), so committing it would let a
# stale score masquerade as a fresh one.
reports/
.stryker-tmp/
stryker.log

# Measurement scratch: JSON dumps and one-off probes kept while a change is
# being verified. Never imported, never shipped, and never worth a lint error.
.scratch/

# Isolated checkouts for parallel workstreams.
.worktrees/

# The scratchpad and its last-read marker: the author's own queue between passes, so
# both are per-machine. `pnpm scratchpad` creates the file from a template on demand.
.scratchpad.md
.scratchpad-seen

# The Starlight content is generated from `docs/` by `scripts/sync-docs.mjs`:
# pages, frontmatter and the copied assets are build input, not source. Edit
# `docs/` instead.
apps/docs/src/content/docs/
apps/docs/dist/
apps/docs/.astro/
apps/site/dist/
apps/site/.astro/
internal/
