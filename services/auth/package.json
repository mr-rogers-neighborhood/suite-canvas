{
  "name": "@suite/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Control plane for owned workspaces: Better Auth organizations, invite keys, claim-workspace and the server-side seat check. A workspace package so `turbo run typecheck` and `turbo run test` gate the identity path.",
  "exports": {
    ".": "./src/index.ts",
    "./seats": "./src/organizations/seats.ts",
    "./principals": "./src/identity/principal.ts",
    "./repository": "./src/store/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.14",
    "@octopi-ai/better-enrollment": "0.7.0",
    "better-auth": "^1.7.14",
    "better-auth-harmony": "^1.3.2",
    "kysely": "0.29.7",
    "neverthrow": "^8.2.0",
    "pg": "^8.23.1",
    "remeda": "^2.54.1"
  }
}
