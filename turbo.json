{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@suite/docs#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  },
  "globalPassThroughEnv": [
    "POSTGRES_PORT",
    "SUITE_DOMAIN",
    "SUITE_DRILL_ORIGIN",
    "SUITE_DRILL_EMAIL",
    "SUITE_DRILL_PASSWORD",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_WEBHOOK_SECRET_LIVE"
  ]
}
