{
  "name": "@suite/billing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Billing on @better-auth/stripe: the plugin the auth instance mounts, the tier table behind it, and the entitlement read the control plane serves. No webhook handler, checkout call or subscription store of our own.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@better-auth/stripe": "1.7.12",
    "better-auth": "^1.7.12",
    "neverthrow": "^8.2.0",
    "pg": "^8.23.1",
    "stripe": "^22.6.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ]
}
