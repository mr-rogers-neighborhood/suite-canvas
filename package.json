{
  "name": "suite",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bench": "vitest bench --config vitest.bench.config.ts --reporter=verbose",
    "build": "turbo run build",
    "build-storybook": "pnpm --filter @suite/canvas build-storybook",
    "check": "biome check . && turbo run typecheck && vitest run --changed && pnpm docs:symbols && pnpm shape",
    "check:full": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:stories && pnpm build && pnpm docs:check && pnpm docs:symbols && pnpm shape && pnpm security:secrets",
    "clean": "rm -rf apps/*/dist apps/*/storybook-static packages/*/dist .turbo apps/*/.turbo packages/*/.turbo",
    "coverage": "vitest run --coverage",
    "coverage:graph": "vitest run --coverage --project=graph --coverage.include='packages/graph/src/**'",
    "dev": "turbo run dev",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "docs:check": "node scripts/docs-check.mjs && node scripts/generate-doc-indexes.mjs --check && node scripts/sync-handbook.mjs --check",
    "docs:index": "node scripts/generate-doc-indexes.mjs",
    "docs:symbols": "node scripts/check-docs-symbols.mjs",
    "doctor": "node scripts/doctor.mjs",
    "e2e": "pnpm --filter @suite/e2e e2e",
    "e2e:canvas": "pnpm --filter @suite/e2e e2e:canvas",
    "e2e:changed": "pnpm --filter @suite/e2e e2e:changed",
    "e2e:desktop": "pnpm --filter @suite/e2e e2e:desktop",
    "e2e:doctor": "pnpm --filter @suite/e2e e2e:doctor",
    "e2e:full": "pnpm --filter @suite/e2e e2e:full",
    "e2e:headed": "pnpm --filter @suite/e2e e2e:headed",
    "e2e:logs": "pnpm --filter @suite/e2e e2e:logs",
    "e2e:smoke": "pnpm --filter @suite/e2e e2e:smoke",
    "e2e:stop": "pnpm --filter @suite/e2e e2e:stop",
    "e2e:trace": "pnpm --filter @suite/e2e e2e:trace",
    "e2e:ui": "pnpm --filter @suite/e2e e2e:ui",
    "e2e:ui:stop": "pnpm --filter @suite/e2e e2e:ui:stop",
    "e2e:views": "pnpm --filter @suite/e2e e2e:views",
    "format": "biome format --write .",
    "knip": "knip",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "mutation": "stryker run stryker.graph.config.mjs",
    "mutation:quick": "stryker run stryker.quick.config.mjs",
    "prepare": "husky",
    "scratchpad": "node scripts/scratchpad.mjs",
    "security:deps": "pnpm audit --audit-level high && pnpm audit signatures",
    "security:history": "node scripts/security-secrets.mjs --history",
    "security:osv": "node scripts/security-osv.mjs",
    "security:secrets": "node scripts/security-secrets.mjs",
    "shape": "node scripts/check-shape.mjs",
    "storybook": "pnpm --filter @suite/canvas storybook",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:stories": "pnpm --filter @suite/canvas test:stories",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "verify": "node scripts/scratchpad.mjs --quiet && pnpm lint && pnpm typecheck && pnpm test && pnpm test:stories && pnpm build && pnpm docs:check && pnpm docs:symbols && pnpm shape && pnpm security:deps && pnpm security:secrets"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "marked": "^18.1.3",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}": "biome check --write"
  },
  "license": "MIT",
  "dependencies": {
    "@suite/contracts": "git+https://github.com/mr-rogers-neighborhood/suite-start.git#v0.2.0&path:/packages/contracts",
    "@suite/desktop": "link:../suite-start/packages/desktop",
    "@suite/files": "git+https://github.com/mr-rogers-neighborhood/suite-start.git#v0.2.0&path:/packages/files",
    "@suite/sync": "link:../suite-sync/packages/protocol"
  }
}
