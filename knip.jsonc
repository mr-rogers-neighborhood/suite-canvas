{
  // Dead-code and dependency-drift reporting. `pnpm knip` is a report, not a
  // gate: it exits 1 on the unused-export list, which is deliberate. Most of that
  // list is exported for a co-located test and imported by nothing else, and the
  // rest is a vocabulary the modules share (mode names, constants that name a
  // value the code compares against). Deleting either kind to satisfy a report
  // makes the next change worse. What the report is trusted for is `Unused
  // files` and `Unused devDependencies`: those were two real findings, and the
  // two configuration entries below are the false ones, silenced where they are
  // generated rather than deleted.
  //
  // This file exists so the run resolves the same entry points the app actually
  // starts from instead of guessing, which keeps the report free of false
  // "unused file" noise.
  //
  // Knip's own plugins (vite, tsx, playwright, vitest) already resolve most of
  // what is spelled out here, so it prints "Remove redundant entry pattern" and
  // "Remove from ignore" under *Configuration hints*. Those hints are not
  // findings: the entries are recorded intent, and the report's value is the
  // unused-file/export/dependency list above them.
  //
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "ignore": [
    "dist/**",
    "coverage/**",
    "storybook-static/**",
    "e2e/test-results/**",
    "reports/**",
    "patches/**",
    "apps/docs/dist/**",
    "apps/docs/.astro/**",
    "apps/docs/src/content/docs/**",
    "apps/site/dist/**",
    "apps/site/.astro/**"
  ],
  // Postgres client binaries the e2e harness shells out to; knip cannot see a
  // `spawn`, so they would otherwise read as unlisted.
  "ignoreBinaries": ["psql", "initdb"],
  "workspaces": {
    ".": {
      // The repo-root `.mjs` scripts are run by `pnpm <script>`, which knip does
      // not read as an import edge.
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/*.mjs"]
    },
    "apps/canvas": {
      // Vite's HTML entry resolves `src/main.tsx`; `admin.html` is the operator
      // panel, a second bundle with its own entry.
      "entry": ["index.html", "admin.html", "src/main.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/collab-server": {
      // `server.ts` is the relay, `ops/admin.ts` and `licenceCli.ts` are the
      // two operator entry points (`pnpm admin`, `pnpm licence`).
      "entry": ["src/server.ts", "src/ops/admin.ts", "src/licenceCli.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/docs": {
      // Astro's entries are the config, the pages and the build integration; the
      // content tree is generated by `scripts/sync-docs.mjs`.
      "entry": ["astro.config.mjs", "src/pages/**/*.{ts,astro}", "src/integrations/**/*.ts"],
      "project": ["src/**/*.{ts,astro}"]
    },
    "apps/site": {
      // One static page; `astro.config.mjs` is the entry knip needs.
      "entry": ["astro.config.mjs", "src/pages/**/*.astro"],
      "project": ["src/**/*.{ts,astro}"]
    },
    "packages/graph": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/licence": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "services/auth": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "services/billing": {
      // Lambda handlers plus the local dry-run driver (`pnpm dry-run`).
      "entry": ["src/handler/handler.ts", "src/ops/dev.ts", "src/stripe/checkout.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/control-plane": {
      // The `test-fixtures/*` trees are mounted or required by path by the boot
      // tests, so no import edge exists for knip to follow.
      "entry": ["src/**/*.ts", "src/modules/test-fixtures/**/*.js"],
      "project": ["src/**/*.{ts,js}"]
    },
    "e2e": {
      "entry": ["tests/**/*.spec.ts"],
      "project": ["**/*.ts"]
    }
  }
}
