{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["SUITE_E2E_WINDOW_POSITION", "SUITE_E2E_WINDOW_SIZE"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
