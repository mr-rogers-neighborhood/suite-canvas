# Copy to `.env` next to this file and adjust; docker compose reads it
# automatically. Every variable the server validates appears here, and
# `compose.yaml` passes all of them through. An empty or commented value means
# "use the built-in default"; a malformed value stops the server at boot with a
# message naming the variable. Never commit `.env` -- it holds root credentials.

# ---------------------------------------------------------------- entry point
# Public hostname Caddy serves and requests a certificate for. Required for a
# real deployment. `localhost` uses Caddy's internal CA (browsers warn).
SUITE_DOMAIN=canvas.example.com

# ACME account email. Uncomment the `email` line in deploy/Caddyfile to use it.
SUITE_ACME_EMAIL=ops@example.com

# Image to run. Pin a release tag on a deployed host; unset follows `:latest`.
# `docker compose up -d --build` ignores this and builds from the checkout.
# SUITE_IMAGE=ghcr.io/mr-rogers-neighborhood/suite:v1.4.0

# Base URL used for links created by POST /api/admin/fixtures. Behind a proxy,
# set it so fixture links work outside the host.
# SUITE_PUBLIC_URL=https://canvas.example.com

# ------------------------------------------------------------------ credentials
# Operator token for /api/admin/*, /metrics and the /admin panel; at least 16
# characters. Generate with `openssl rand -base64 32`. Unset turns the admin
# API and the panel off (404), which is the safe default.
SUITE_ADMIN_TOKEN=

# Worker tokens. Generate each with `openssl rand -base64 32`; when unset the
# server generates one per start, which only matters if a worker reconnects.
SUITE_PROJECTION_TOKEN=
SUITE_SOURCE_TOKEN=
# Legacy alias for SUITE_PROJECTION_TOKEN, still accepted; leave unset.
# SUITE_INTERNAL_TOKEN=

# ------------------------------------------------------------------------- mode
# 1 = hosted relay: licences are enforced and the hosted quota defaults apply.
# 0 = self-host: no licence, unlimited quotas unless you set them below.
SUITE_HOSTED=0

# Ed25519 public key that verifies licences; required when SUITE_HOSTED=1.
# Generate the pair offline with:
#   pnpm --filter @suite/collab-server licence generate-keypair --out ./licence-private.pem
# Paste the printed public key here and keep the private key out of the repo.
SUITE_LICENCE_PUBLIC_KEY=

# Extra browser origins allowed to call the HTTP API (comma separated). Leave
# empty for a same-origin deployment: Caddy proxies `/api` and `/ws`, so the
# browser never makes a cross-origin request.
SUITE_ALLOWED_ORIGINS=

# 1 uses the first X-Forwarded-For hop as the client address for rate limits.
# Read the caveat in docs/deploy-aws.md before enabling it behind Cloudflare:
# Caddy then sees Cloudflare's edge, not the visitor, unless it trusts them.
SUITE_TRUST_PROXY=0

# info (default), debug, warn or error. debug logs every request detail.
SUITE_LOG_LEVEL=info

# ------------------------------------------------------------------------- ports
# Fixed by compose.yaml (1234 sync, 1235 HTTP/health). Only override together
# with the matching `expose`/proxy configuration.
# PORT=1234
# HEALTH_PORT=1235

# Version stamp reported by /metrics, /api/admin/status and the startup line.
# The image sets it from the release tag; empty is rejected, so leave it unset
# unless you build locally and want a different stamp.
# SUITE_VERSION=0.0.0

# ---------------------------------------------------------------------- storage
# Six stores exist in code (`documents`, `shares`, `workspaces`, `settings`,
# `licences`, `attachments`) and `compose.yaml` configures all six on the
# `suite-data` volume. Attachments used to default to the process working
# directory, and settings and licences to `:memory:`; all three were lost when
# the container was recreated. Every store below therefore defaults to a file
# under `/data`, and a restore replaces all six together.
#
# Only override for a custom layout, and give each store its own file (or
# `:memory:`, which makes that store disposable). Paths outside `/data` are not
# in the volume, so they are not backed up and not restored.
# SUITE_DB=/data/documents.sqlite
# SUITE_SHARES_DB=/data/shares.sqlite
# SUITE_WORKSPACES_DB=/data/workspaces.sqlite
# SUITE_SETTINGS_DB=/data/settings.sqlite
# SUITE_LICENCE_DB=/data/licences.sqlite
# SUITE_ATTACHMENTS_DB=/data/attachments.sqlite

# ---------------------------------------------------------------------- billing
# Hosted Stripe billing is closed for the alpha. The webhook refuses before it
# reads a signature, claims an event, or mints a licence. Set to 1 only when a
# durable BillingStore and a live Stripe test-mode E2E exist.
# SUITE_BILLING_ENABLED=0

# ----------------------------------------------------------------------- quotas
# Bytes, counts, or "unlimited". Leaving them unset is the safe choice: a
# self-host is unlimited (except the 100 links / 200 cards caps below), and
# SUITE_HOSTED=1 installs a 32 MiB projection budget plus 4 GiB / 5 GiB disk
# watermarks. Setting "unlimited" here would override those guardrails.
# SUITE_MAX_WORKSPACES=unlimited
# SUITE_DOCUMENT_BYTES_PER_WORKSPACE=unlimited
# SUITE_PROJECTION_BYTES_PER_WORKSPACE=unlimited
# SUITE_ATTACHMENT_BYTES_PER_WORKSPACE=unlimited
SUITE_MAX_SHARES_PER_WORKSPACE=100
SUITE_MAX_SELECTION_CARDS=200
# SUITE_DISK_SOFT_BYTES=unlimited
# SUITE_DISK_HARD_BYTES=unlimited

# ------------------------------------------------------------- rate limits/min
# Server-side limiters, per client address. Empty keeps the default shown.
# SUITE_CLAIM_RATE_LIMIT=600
# SUITE_ROTATE_RATE_LIMIT=10
# SUITE_SHARE_RESOLVE_RATE_LIMIT=300
# SUITE_SHARE_CREATE_RATE_LIMIT=30
# SUITE_PUBLISH_RATE_LIMIT=20
# SUITE_ADMIN_RATE_LIMIT=300

# ------------------------------------------------------------ build-time only
# Baked into the canvas bundle by `pnpm build`; leave empty for the same-origin
# defaults (`/api` and `ws(s)://<host>/ws`).
# VITE_COLLAB_HTTP_URL=
# VITE_COLLAB_URL=
