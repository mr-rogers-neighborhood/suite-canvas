{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "SUITE_CANVAS_LIBRARY",
    "SUITE_CANVAS_DATA",
    "SUITE_DESKTOP_DEV_URL",
    "SUITE_DEV_PORT"
  ]
}
